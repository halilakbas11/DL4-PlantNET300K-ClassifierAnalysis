# ==========================================
# DLP4 Git Ignore System
# ==========================================

# ── User Requested Exclusions ─────────────
# Exclude model weight files
*.tar
*.tar.gz
*.tgz
*.zip
*.rar

# Exclude presentation decks
*.pptx
# Exclude temporary PowerPoint lock files (Windows)
~$*.pptx
*~$*.pptx

# Exclude visual slide assets folder
Slide-images/

# Exclude dynamically converted images (webp-to-png helper artifacts)
*_converted.png

# ── Python & PyTorch Caches ───────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
*.pt
*.pth
*.onnx
*.tflite
*.pb

# ── Flask & Environment Secrets ───────────
.env
.flaskenv
instance/
.webassets-cache

# ── IDEs & Editors ───────── ──────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# ── OS Generated Files ────────────────────
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.Spotlight-V100
.Trashes
